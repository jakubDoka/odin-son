			.Ne = #partial{.I8 ..= .I32 = .I32_Ne, .I64 = .I64_Ne},
			.Lt = #partial{.I8 ..= .I32 = .I32_Lt_S, .I64 = .I64_Lt_S},
			.Le = #partial{.I8 ..= .I32 = .I32_Le_S, .I64 = .I64_Le_S},
