package main

main :: proc(cx: f32, cy: f32) -> f32 {
    zx := f32(0.0)
    zy := f32(0.0)
    depth := f32(0.0)
    // Integer arithmetic is not implemented by this GPU backend.
    for i := f32(0.0); i < 25.0; i += 1.0 {
        xx := zx * zx
        yy := zy * zy
        nx := xx - yy + cx
        ny := 2.0 * zx * zy + cy
        zx = nx
        zy = ny
        depth += 1.0
        if zx*zx + zy*zy > 4.0 do break
    }
    return depth * 0.04
}
