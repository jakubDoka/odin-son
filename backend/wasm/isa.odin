			},
		}

	@(rodata)
	NODE_TO_OP := #partial [WASM_Node_Type][backend.Node_Datatype]Wasm_Opcode {
			.Add = #partial{.I8 ..= .I32 = .I32_Add, .I64 = .I64_Add},
			.Sub = #partial{.I8 ..= .I32 = .I32_Sub, .I64 = .I64_Sub},
			.Mul = #partial{.I8 ..= .I32 = .I32_Mul, .I64 = .I64_Mul},
