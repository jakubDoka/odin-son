				.I16 = .I16x8_Gt_U,
				.I32 = .I32x4_Gt_U,
			},
			.U_Le = #partial{
				.I8 = .I8x16_Le_U,
				.I16 = .I16x8_Le_U,
				.I32 = .I32x4_Le_U,
			},
			.U_Ge = #partial{
				.I8 = .I8x16_Ge_U,
				.I16 = .I16x8_Ge_U,
				.I32 = .I32x4_Ge_U,
			},
			.Shl = #partial{
				.I8 = .I8x16_Shl,
				.I16 = .I16x8_Shl,
				.I32 = .I32x4_Shl,
				.I64 = .I64x2_Shl,
			},
			.Shr = #partial{
				.I8 = .I8x16_Shr_S,
