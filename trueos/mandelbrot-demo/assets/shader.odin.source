package main

main :: proc(cx, cy: f32) -> f32 {
    zx := f32(0.0)
    zy := f32(0.0)
    depth := f32(0.0)
    active := true
    for i := f32(0.0); i < 2.0; i += 1.0 {
        xx := zx * zx
        yy := zy * zy
        nx := xx - yy + cx
        ny := 2.0 * zx * zy + cy
        if active {
            zx = nx
            zy = ny
            depth += 1.0
            active = (zx * zx + zy * zy) <= 4.0
        }
    }
    return depth * 0.04
}
