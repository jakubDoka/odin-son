	I32_Rem_U            = 0x70,
	I32_And              = 0x71,
	I32_Or               = 0x72,
	I32_Xor              = 0x73,
	I32_Shl              = 0x74,
	I32_Shr_S            = 0x75,
	I32_Shr_U            = 0x76,
	I32_Rotl             = 0x77,
