				.I32 = .I32x4_Ne,
				.I64 = .I64x2_Ne,
			},
			.Lt = #partial{
				.I8 = .I8x16_Lt_S,
				.I16 = .I16x8_Lt_S,
				.I32 = .I32x4_Lt_S,
				.I64 = .I64x2_Lt_S,
