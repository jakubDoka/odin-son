package wasm

import ".."

encode_func_type :: proc(
	buf: ^[dynamic]u8,
	params: []backend.Param_Spec,
	ret_dts: []backend.Node_Datatype,
) {
	putb :: backend.putb
	uleb :: backend.uleb

	putb(buf, Type.fnc)

	param_count := 0
	for param in params {
		param_count += int(param.dt != .Void)
	}
	uleb(buf, u64(param_count))

	for param in params {
		if param.dt != .Void {
			putb(buf, DT_TO_VALTYPE[param.dt])
		}
	}

	uleb(buf, u64(len(ret_dts)))
	for ret in ret_dts {
		putb(buf, DT_TO_VALTYPE[ret])
	}
}

when !GEN_SPEC {
	@(rodata)
	NODE_TO_LANE_OP :=
		#partial [WASM_Node_Type][backend.Lane_Type]Wasm_Opcode_FD {
			.Add = #partial{
				.I8 = .I8x16_Add,
				.I16 = .I16x8_Add,
				.I32 = .I32x4_Add,
				.I64 = .I64x2_Add,
			},
			.Sub = #partial{
				.I8 = .I8x16_Sub,
				.I16 = .I16x8_Sub,
				.I32 = .I32x4_Sub,
				.I64 = .I64x2_Sub,
			},
			.And = #partial{.I8 ..= .I64 = .V128_And},
			.Xor = #partial{.I8 ..= .I64 = .V128_Xor},
			.Or = #partial{.I8 ..= .I64 = .V128_Or},
			.Mul = #partial{
				.I16 = .I16x8_Mul,
