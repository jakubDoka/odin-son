	Array_Fill         = 16,
	Array_Copy         = 17,
	Array_Init_Data    = 18,
	Array_Init_Elem    = 19,
	Ref_Test           = 20,
	Ref_Test_Null      = 21,
	Ref_Cast           = 22,
	Ref_Cast_Null      = 23,
	Br_On_Cast         = 24,
	Br_On_Cast_Fail    = 25,
	Any_Convert_Extern = 26,
	Extern_Convert_Any = 27,
	Ref_I31            = 28,
	I31_Get_S          = 29,
