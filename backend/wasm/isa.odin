	F64_Promote_F32      = 0xBB,
	I32_Reinterpret_F32  = 0xBC,
	I64_Reinterpret_F64  = 0xBD,
	F32_Reinterpret_I32  = 0xBE,
	F64_Reinterpret_I64  = 0xBF,

	// Sign extension
	I32_Extend8_S        = 0xC0,
	I32_Extend16_S       = 0xC1,
	I64_Extend8_S        = 0xC2,
	I64_Extend16_S       = 0xC3,
	I64_Extend32_S       = 0xC4,

	// Reference instructions with single-byte opcodes
	Ref_Null             = 0xD0,
	Ref_Is_Null          = 0xD1,
	Ref_Func             = 0xD2,
	Ref_Eq               = 0xD3,
	Ref_As_Non_Null      = 0xD4,
}

