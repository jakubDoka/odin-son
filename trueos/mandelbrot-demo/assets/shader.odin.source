package main

@(tag = "gpu")
process :: proc(cx, cy: f32) -> f32 {
    zx := 0.0
    zy := 0.0
    depth := 0.0
    active := true
    for i := 0; i < 2; i += 1 {
        xx := zx * zx
        yy := zy * zy
        nx := xx - yy + cx
        ny := 2.0 * zx * zy + cy
        zx = active ? nx : zx
        zy = active ? ny : zy
        depth = active ? depth + 1.0 : depth
        active = active ? ((zx * zx + zy * zy) <= 4.0) : false
    }
    return depth * 0.04
}

main :: proc() -> int {
    return int(process(0.0, 0.0))
}
