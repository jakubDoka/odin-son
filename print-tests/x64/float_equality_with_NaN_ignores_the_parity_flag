=========== OPT LEVEL: none-quick ===========
nan:
    movsd xmm1, xmm0
    subsd xmm1, xmm0
    divsd xmm0, xmm1
    ret
main:
    sub rsp, 8
    pxor xmm0, xmm0
    call nan
    movsd.q xmm1, [rip + 0xf44]
    ucomisd xmm0, xmm1
    sete al
    jnp 2
    mov al, 0
2:
    movzx rax, al
    movzx eax, al
    ucomisd xmm0, xmm1
    setne cl
    jnp 3
    mov cl, 1
3:
    movzx rcx, cl
    movzx ecx, cl
    lea rax, [rax + rcx*2]
    add rsp, 8
    ret
