	// i64 arithmetic / bit operations
	I64_Clz              = 0x79,
	I64_Ctz              = 0x7A,
	I64_Popcnt           = 0x7B,
	I64_Add              = 0x7C,
	I64_Sub              = 0x7D,
	I64_Mul              = 0x7E,
	I64_Div_S            = 0x7F,
	I64_Div_U            = 0x80,
	I64_Rem_S            = 0x81,
	I64_Rem_U            = 0x82,
	I64_And              = 0x83,
	I64_Or               = 0x84,
	I64_Xor              = 0x85,
	I64_Shl              = 0x86,
	I64_Shr_S            = 0x87,
	I64_Shr_U            = 0x88,
	I64_Rotl             = 0x89,
	I64_Rotr             = 0x8A,

	// f32 arithmetic
	F32_Abs              = 0x8B,
	F32_Neg              = 0x8C,
	F32_Ceil             = 0x8D,
	F32_Floor            = 0x8E,
	F32_Trunc            = 0x8F,
	F32_Nearest          = 0x90,
	F32_Sqrt             = 0x91,
	F32_Add              = 0x92,
	F32_Sub              = 0x93,
	F32_Mul              = 0x94,
	F32_Div              = 0x95,
	F32_Min              = 0x96,
	F32_Max              = 0x97,
	F32_Copysign         = 0x98,

	// f64 arithmetic
	F64_Abs              = 0x99,
	F64_Neg              = 0x9A,
	F64_Ceil             = 0x9B,
	F64_Floor            = 0x9C,
	F64_Trunc            = 0x9D,
	F64_Nearest          = 0x9E,
	F64_Sqrt             = 0x9F,
	F64_Add              = 0xA0,
	F64_Sub              = 0xA1,
	F64_Mul              = 0xA2,
	F64_Div              = 0xA3,
	F64_Min              = 0xA4,
	F64_Max              = 0xA5,
	F64_Copysign         = 0xA6,

	// Conversions
	I32_Wrap_I64         = 0xA7,
	I32_Trunc_F32_S      = 0xA8,
	I32_Trunc_F32_U      = 0xA9,
	I32_Trunc_F64_S      = 0xAA,
	I32_Trunc_F64_U      = 0xAB,
	I64_Extend_I32_S     = 0xAC,
