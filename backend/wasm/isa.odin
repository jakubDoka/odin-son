				.I8 = .I8x16_Ge_S,
				.I16 = .I16x8_Ge_S,
				.I32 = .I32x4_Ge_S,
				.I64 = .I64x2_Ge_S,
			},
			.U_Lt = #partial{
				.I8 = .I8x16_Lt_U,
				.I16 = .I16x8_Lt_U,
