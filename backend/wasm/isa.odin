				.I16 = .I16x8_Shr_U,
				.I32 = .I32x4_Shr_U,
				.I64 = .I64x2_Shr_U,
			},
			.F_Add = #partial{.F32 = .F32x4_Add, .F64 = .F64x2_Add},
			.F_Sub = #partial{.F32 = .F32x4_Sub, .F64 = .F64x2_Sub},
			.F_Mul = #partial{.F32 = .F32x4_Mul, .F64 = .F64x2_Mul},
			.F_Div = #partial{.F32 = .F32x4_Div, .F64 = .F64x2_Div},
			.F_Eq = #partial{.F32 = .F32x4_Eq, .F64 = .F64x2_Eq},
			.F_Ne = #partial{.F32 = .F32x4_Ne, .F64 = .F64x2_Ne},
			.F_Lt = #partial{.F32 = .F32x4_Lt, .F64 = .F64x2_Lt},
			.F_Le = #partial{.F32 = .F32x4_Le, .F64 = .F64x2_Le},
			.F_Gt = #partial{.F32 = .F32x4_Gt, .F64 = .F64x2_Gt},
			.F_Ge = #partial{.F32 = .F32x4_Ge, .F64 = .F64x2_Ge},
			.Neg = #partial{.F32 = .F32x4_Neg, .F64 = .F64x2_Neg},
			.Extract_Lane_U = #partial{
