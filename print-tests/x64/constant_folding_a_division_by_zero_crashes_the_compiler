=========== OPT LEVEL: none-quick ===========
dv:
    mov.q [rsp - 0x8], rdi
    mov.q rax, [rsp - 0x8]
    cqo
    idiv rsi
    mov rax, rax
    ret
pick:
    mov rax, rdi
    ret
main:
    sub rsp, 8
    mov rdi, 3
    call pick
    cmp rax, 0x64
    jg 3
    mov rax, 7
    jmp 4
3:
    mov rdi, 1
    xor esi, esi
    call dv
4:
    add rsp, 8
    ret
